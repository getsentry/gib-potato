#!/usr/bin/env ruby

# Written in Ruby rather than shell, as the distroless runtime image ships no shell.

# Enable jemalloc for reduced memory usage and latency.
unless ENV.key?("LD_PRELOAD")
  jemalloc = Dir.glob("/usr/lib/**/libjemalloc.so.2").first
  ENV["LD_PRELOAD"] = jemalloc if jemalloc
end

# Cloud Run sends traffic to PORT, but Thruster listens on HTTP_PORT and proxies
# to TARGET_PORT. Derive TARGET_PORT from HTTP_PORT so they never collide.
if ENV["PORT"].to_s != "" && ENV["HTTP_PORT"].to_s == ""
  ENV["HTTP_PORT"] = ENV["PORT"]
  ENV["TARGET_PORT"] ||= (ENV["PORT"].to_i + 1).to_s
end

# If running the rails server then create or migrate existing database
if ARGV.last(2) == ["./bin/rails", "server"]
  exit($?.exitstatus || 1) unless system(Gem.ruby, "./bin/rails", "db:prepare")
end

exec(*ARGV)
